{
    "name": "orm-benchmark/php",
    "description": "PHP ORM benchmark: raw SQL, Eloquent, Doctrine",
    "require": {
        "php": "^8.3",
        "illuminate/database": "11.51.0",
        "illuminate/events": "11.51.0",
        "doctrine/orm": "3.6.7",
        "doctrine/dbal": "4.4.3",
        "symfony/cache": "7.4.13"
    },
    "autoload": {
        "psr-4": {
            "Benchmark\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.31"
        }
    }
}
